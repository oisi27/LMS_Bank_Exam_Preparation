# Bank Exam LMS Server Environment Variables Example
PORT=5000
NODE_ENV=development
JWT_SECRET=bank_lms_super_secret_jwt_key_2026
JWT_REFRESH_SECRET=bank_lms_super_secret_refresh_key_2026
CLIENT_ORIGIN=http://localhost:5173
DB_PATH=./bank_exam.db

# SMTP Email Configuration (for OTP delivery)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=your_smtp_password_here
SMTP_FROM="Bank LMS <no-reply@banklms.ac.bd>"
OTP_DELIVERY_MODE=console

# SMS Gateway Configuration (Optional)
SMS_GATEWAY_URL=
SMS_API_KEY=
SMS_SENDER_ID=BANKLMS
SMS_DELIVERY_MODE=console
